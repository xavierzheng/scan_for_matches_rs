% 10_DMM_Maverick_seed30_mm2.pat: 10_DMM_Maverick_seed30 with up to 2 substitutions in the right TIR (~p2[2,0,0]); TSD exact
%@element Maverick_element Name=DMM Classification=MAV/DMM
p1=6...6      %@ target_site_duplication
p2=30...30    %@ five_prime_terminal_inverted_repeat
9940...19940
~p2[2,0,0]    %@ three_prime_terminal_inverted_repeat
p1            %@ target_site_duplication
